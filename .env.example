APP_ENV="Production"

# Database Configuration (PostgreSQL in cloud or SQLite fallback)
DATABASE_URL=postgresql://postgres:password@localhost:5432/mnemora_db

# LLM Provider Configuration
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# Vector Store (Qdrant Cloud or In-Memory)
QDRANT_URL=https://your-qdrant-instance.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here

# Production Observability & Monitoring Platform Integration
MONITORING_URL=http://localhost:8000
ENABLE_MONITORING_TELEMETRY=true

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
